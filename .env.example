# 智谱 GLM API 配置
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.0

# LangSmith 可观测性(可选,留空则不启用 tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=med-safety-agent

# 交互检测模式: graph(默认,确定性图谱直查) | react(慢速 ReAct 工具循环)
DETECT_MODE=graph

# 风险评估模式: semantic(默认,单次结构化输出) | react(慢速 ReAct) | rules(纯规则,无LLM)
RISK_MODE=semantic

# 记忆系统(向量检索):true 开 / false 关
# 关闭原因:依赖 sentence-transformers + faiss,首次调用下载约 400MB 的 bge-small-zh 模型,
# 常驻占数百 MB 内存。公网免费层(Render 512MB / Railway 500MB)会 OOM,部署时设 false。
# 关闭后核心审查链路(知识图谱 + 规则引擎 + LLM 推理)完全不受影响。
ENABLE_MEMORY=true

# 图谱数据路径(可选,默认 <项目根>/data/drug_graph.json)
# 注意:必须写绝对路径,或在项目根目录启动服务;相对路径会随工作目录漂移。
# 患者档案路径不需要单独配置 —— 代码取 graph_path 同级目录下的 patients.json。
# GRAPH_PATH=data/drug_graph.json
