# 智谱 GLM API 配置
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.0

# LangSmith 可观测性(可选,留空则不启用 tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=med-safety-agent

# 交互检测模式: graph(默认,确定性图谱直查) | react(慢速 ReAct 工具循环)
DETECT_MODE=graph

# 风险评估模式: semantic(默认,单次结构化输出) | react(慢速 ReAct) | rules(纯规则,无LLM)
RISK_MODE=semantic

# 图谱数据路径
GRAPH_PATH=data/drug_graph.json

# 患者档案存储路径
PATIENT_STORE_PATH=data/patients.json
