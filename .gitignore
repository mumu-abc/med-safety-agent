# Docker
# 注意:.dockerignore 必须进仓库。之前它被写在这里,导致 clone 后 docker build
# 的 `COPY . .` 会把 .venv(1.6G)、*.db、.env(密钥进镜像层)全部打进镜像。

# Data (保留图谱与评测用例,忽略运行时产物)
*.log
*.db
data/med_safety.db
data/memory_index/
data/*_results.json
data/judge_results.json

# 本地工具/临时目录
.trae-html-share-packages/
agent-project-analysis/
# 整目录快照式本地备份(如 _backup_before_full_eval_YYYYMMDD/),仅本地留档不入库
/_backup_*/

# ---- 调试产物白名单式拦截(2026-09-15 清理了 63 个误提交文件)----
# 根目录的临时输出捕获(我习惯 `xxx > out.txt` 存终端输出,别再 git add -A 卷进来)
/*.txt
!/requirements.txt
!/requirements-dev.txt
!/requirements.deploy.txt
# scripts/ 下划线开头的临时脚本/调试产物(不限后缀:_*.py、_*.js 都算)
/scripts/_*
# Streamlit 时代遗留的静态资源(前端已改原生 HTML,已确认无任何引用)
/lib/
